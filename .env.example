# .env.example — Variables para docker compose (raíz del proyecto)
# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube a git (está en .gitignore).
#
# Para desarrollo sin Docker, usa backend/.env.example en su lugar.

# ── Requerido ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Opcionales (se usan los defaults si se omiten) ────────
GROQ_MODEL=llama-3.1-8b-instant
TOP_K=4
MAX_MESSAGE_LENGTH=500
LOG_LEVEL_STR=INFO

# ── Embeddings ────────────────────────────────────────────
# En Docker siempre es cpu (no hay GPU disponible en el contenedor por defecto)
EMBEDDING_DEVICE=cpu
